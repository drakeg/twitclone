# Runtime environment: development, testing, or production
TWITCLONE_ENV=development

# Host interface and port exposed by Docker Compose for Ripple.
# 0.0.0.0 allows access from other devices on your LAN; use 127.0.0.1 for host-only access.
# The container itself always listens on port 8000.
RIPPLE_BIND_HOST=0.0.0.0
RIPPLE_PORT=8000

# Required in production. Generate a long random value; never commit the real secret.
SECRET_KEY=replace-with-a-random-secret

# Docker Compose durable local defaults. Production requires a PostgreSQL connection URL.
# If running Python directly on the host instead of Compose, export host-appropriate paths instead.
DATABASE_URL=sqlite:////data/twitclone.db
UPLOAD_FOLDER=/data/uploads

# Media storage. Filesystem is for local development; production requires s3.
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_PREFIX=media

# Background scheduled-post controls. Compose uses a dedicated worker, so the in-process scheduler stays disabled.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

# Account recovery and email ownership verification. Development suppresses delivery by default
# and logs recovery/verification URLs. Production must deliver real email.
PASSWORD_RESET_MAX_AGE_SECONDS=3600
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=no-reply@ripple.local
MAIL_TIMEOUT_SECONDS=10

# Stripe billing. Leave disabled until test-mode keys and a webhook secret are configured.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pin the Stripe API contract independently from the stripe-python SDK major.
STRIPE_API_VERSION=2026-03-25.dahlia
