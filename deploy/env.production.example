# Runtime configuration template only. Never put real production values in Git.
#
# Zero-spend/local handoff:
#   export the values below in your shell, then run:
#   RIPPLE_ENV_FILE=/tmp/ripple.env bash scripts/render-production-env.sh
#
# Future AWS handoff (only after AWS deployment is authorized):
#   store the same keys beneath /ripple/production in SSM Parameter Store,
#   grant the EC2 role read/decrypt access, then run:
#   RIPPLE_CONFIG_SOURCE=ssm bash scripts/render-production-env.sh
#
# Standard Parameter Store parameters have no additional Parameter Store charge;
# do not provision Parameter Store resources yet merely to exercise this contract.

TWITCLONE_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://ripple:replace-me@database-host:5432/ripple
MEDIA_STORAGE_BACKEND=s3
MEDIA_S3_BUCKET=replace-with-private-bucket-name
MEDIA_S3_REGION=us-east-1
MEDIA_S3_PREFIX=media
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

# Stripe remains optional until billing is intentionally enabled.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
