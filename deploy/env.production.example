# Copy this file to a secure host-only location such as /etc/ripple/ripple.env.
# Never commit the populated file.
TWITCLONE_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://ripple:replace-me@database-host:5432/ripple
MEDIA_STORAGE_BACKEND=s3
MEDIA_S3_BUCKET=replace-with-private-bucket-name
MEDIA_S3_REGION=us-east-1
MEDIA_S3_PREFIX=media
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

# Stripe remains optional until billing is intentionally enabled.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
