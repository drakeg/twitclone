{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep local Python aligned with the tested 3.12 runtime",
      "matchManagers": [
        "pyenv"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "3.12"
    }
  ]
}
